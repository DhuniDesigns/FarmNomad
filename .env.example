# FarmNomad local development template. Copy to .env locally and keep secrets out of git.

# Backend
SPRING_PROFILES_ACTIVE=local
BACKEND_PORT=9000
DATABASE_URL=jdbc:postgresql://localhost:5433/farmnomad_db
DATABASE_USERNAME=farmnomad_user
DATABASE_PASSWORD=change-me
JWT_ACCESS_SECRET=replace-with-a-long-random-development-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-development-secret
WEB_ORIGIN=http://localhost:3000
AI_SERVICE_BASE_URL=http://localhost:8010

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:9000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Client-side Mapbox GL rendering only (MapView/LocationPicker) — the
# frontend never needs a token for geocoding itself, that's proxied through
# the backend's GET /api/geo/* endpoints. Blank is fine: MapView renders a
# graceful placeholder instead of a map. Public by design (NEXT_PUBLIC_*),
# so use a Mapbox token scoped to map-rendering, not a secret-level one.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional — same Mapbox account, used server-side by the backend as a
# fallback when postcodes.io can't resolve an address (free-text geocoding,
# non-UK addresses). Not the same variable as NEXT_PUBLIC_MAPBOX_TOKEN above;
# this one is never sent to the browser.
MAPBOX_TOKEN=

# Media and payments
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI service
FARMNOMAD_AI_ENV=local
MODEL_VERSION=stub-v0
